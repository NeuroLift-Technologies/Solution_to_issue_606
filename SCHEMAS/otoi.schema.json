{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/otoi-1.0.0.schema.json",
  "title": "Orchestrated Terms of Interaction (session contract) v1.0.0",
  "description": "JSON Schema for the session-level OTOI document emitted by FUNCTIONS/otoiLoader.ts. Aligns with the @neurolift-technologies/toi v1.0.0 contract that each participant's TOI must satisfy.",
  "type": "object",
  "required": ["otoi_version", "session_id", "created", "participants", "rules"],
  "properties": {
    "otoi_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent_id", "role", "toi"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "toi": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["appliesTo", "description", "enforcement"],
        "properties": {
          "appliesTo": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 1 },
          "enforcement": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
